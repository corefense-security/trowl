%% Render with @mermaid-js/mermaid-cli 12.2.0 and mermaid.config.json
flowchart LR
    accTitle: External resources and cache
    accDescr: The NVD mirror supplies CNA and CPE records. CISA KEV and EPSS supply risk data. Advisory sites supply link checks. Hugging Face supplies model weights. Trowl checks the cache first and fetches missing or stale data before use. No-network scans use cached CVE records and skip scores and links. Cached model weights run the local summary.

    subgraph external[Fetch before use]
        nvd[NVD mirror<br/>CNA + CPE]
        risk[CISA KEV + EPSS]
        sites[Advisory sites]
        hf[Hugging Face]
    end

    subgraph cache[Cache checked first]
        records[(CVE records)]
        scores[(Scores + links)]
        weights[(Model weights)]
    end

    subgraph local[Local consumers]
        match[CVE matching]
        enrich[Add scores + links]
        llm[Local LLM]
    end

    nvd -->|stale / missing| records
    risk -->|stale / missing| scores
    sites -->|stale / missing| scores
    hf -->|missing| weights
    records -->|read / --no-network| match
    scores -->|online only| enrich
    weights -->|load| llm

    classDef external stroke-width:1.2px
    classDef cached stroke-width:1.2px
    classDef local stroke-width:1.2px
    class nvd,risk,sites,hf external
    class records,scores,weights cached
    class match,enrich,llm local
