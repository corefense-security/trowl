---
// Trowl's architecture, left to right: inputs, then parse, analyse and report inside Trowl, with the
// cached external data above the stages that read it. Facts here follow internal/scan/scan.go,
// internal/unpack, internal/sbom, internal/inventory and ui/src.
const TOP = 116; // top of the stage cards
const H = 302; // stage card height
const parse = { x: 160, w: 200 };
const analyse = { x: 380, w: 308 };
const report = { x: 708, w: 172 };
const parsers = [
	{ y: 66, title: 'Image', sub: 'tar · ext4 · squashfs · disk' },
	{ y: 146, title: 'SBOM', sub: 'SPDX 2/3 · CycloneDX' },
	{ y: 198, title: 'Package database', sub: 'opkg · dpkg · rpm' },
	{ y: 250, title: 'Fingerprints', sub: 'versions in ELF files' },
];
const cardW = (analyse.w - 40) / 2;
const checks = [
	{ x: 14, y: 112, title: 'Image checks', sub: ['hardening and', 'secrets'] },
	{ x: 26 + cardW, y: 112, title: 'SBOM presence', sub: ['declared files', 'vs the image'] },
	{ x: 14, y: 206, title: 'CVE matching', sub: ['CNA ranges,', 'then NVD'] },
	{ x: 26 + cardW, y: 206, title: 'Kernel VEX', sub: ['config gates and', 'modules, via kcond'] },
];
const outputs = [
	{ y: 166, title: 'report.json', sub: 'every finding as JSON' },
	{ y: 222, title: 'OpenVEX', sub: 'planned', planned: true },
];
const feeds = [
	{ cx: 470, w: 164, label: 'CVE records · NVD + CNA' },
	{ cx: 620, w: 126, label: 'KEV · EPSS · links' },
	{ cx: 794, w: 110, label: 'Model weights' },
];
const inputs = [
	{ y: 179, title: 'Image', sub: 'required' },
	{ y: 254, title: 'SBOM', sub: 'optional', optional: true },
	{ y: 366, title: 'Kernel tree', sub: '+ config · optional', optional: true },
];
const kernelX = analyse.x + 26 + cardW + cardW / 2;
---
<figure class="arch">
	<div class="scroll" role="region" aria-label="Trowl architecture diagram" tabindex="0">
		<svg viewBox="0 0 900 448" role="img" aria-labelledby="arch-title arch-desc">
			<title id="arch-title">Trowl architecture</title>
			<desc id="arch-desc">The image, an optional SBOM and an optional kernel tree with config go into Trowl, which runs locally. Trowl parses the image (tar, ext4, squashfs or disk) and takes components from the first source found: the SBOM (SPDX 2, SPDX 3 or CycloneDX), the package database (opkg, dpkg or rpm) or fingerprints of versions in ELF files. It then analyses the image: image checks for hardening and secrets, SBOM presence of declared files, CVE matching against CNA ranges then NVD, and kernel VEX from config gates and modules through kcond. CISA KEV, EPSS and advisory links are added to each CVE. The report is index.html, a dashboard of React and Cytoscape views built by Vite into one static file with the report data embedded, plus report.json and, later, OpenVEX, with a summary by a local LLM. CVE records, KEV, EPSS, link results and model weights are fetched once and cached in ~/.cache/trowl.</desc>

			<!-- External data, cached -->
			<rect class="band" x="144" y="4" width="752" height="48" rx="10" />
			<text class="kicker" x="160" y="25">External data</text>
			<text class="sub" x="160" y="41">cached in ~/.cache/trowl</text>
			{feeds.map((f) => (
				<g>
					<rect class="feed" x={f.cx - f.w / 2} y="15" width={f.w} height="26" rx="13" />
					<text class="feedtext" x={f.cx} y="32" text-anchor="middle">{f.label}</text>
					<path class="dash" d={`M${f.cx} 43V${TOP - 4}m-4-5 4 5 4-5`} />
				</g>
			))}

			<!-- Trowl, local -->
			<rect class="host" x="144" y="78" width="752" height="364" rx="12" />
			<text class="kicker" x="160" y="100">Trowl · runs locally</text>

			<!-- Inputs -->
			{inputs.map((i) => (
				<g>
					<rect class:list={['input', { optional: i.optional }]} x="0" y={i.y} width="126" height="52" rx="8" />
					<text class="title" x="14" y={i.y + 23}>{i.title}</text>
					<text class="sub" x="14" y={i.y + 40}>{i.sub}</text>
				</g>
			))}

			<!-- 01 Parse -->
			<g transform={`translate(${parse.x} ${TOP})`}>
				<rect class="stage" width={parse.w} height={H} rx="10" />
				<text class="num" x="14" y="24">01</text>
				<text class="title" x="14" y="44">Parse</text>
				<line class="rule" x1="14" x2={parse.w - 14} y1="56" y2="56" />
				<text class="tag" x="14" y="136">Components, first found</text>
				{parsers.map((p) => (
					<g>
						<rect class="mini" x="12" y={p.y} width={parse.w - 24} height="44" rx="7" />
						<text class="item" x="24" y={p.y + 19}>{p.title}</text>
						<text class="sub" x="24" y={p.y + 35}>{p.sub}</text>
					</g>
				))}
			</g>

			<!-- 02 Analyse -->
			<g transform={`translate(${analyse.x} ${TOP})`}>
				<rect class="stage main" width={analyse.w} height={H} rx="10" />
				<text class="num" x="14" y="24">02</text>
				<text class="title big" x="14" y="45">Analyse</text>
				<line class="rule" x1="14" x2={analyse.w - 14} y1="56" y2="56" />
				<rect class="enrich" x="14" y="66" width={analyse.w - 28} height="34" rx="7" />
				<text class="tag" x="26" y="87">ENRICH</text>
				<text class="enrichtext" x="78" y="87">CISA KEV · EPSS · advisory links</text>
				{checks.map((c) => (
					<g>
						<rect class="card" x={c.x} y={c.y} width={cardW} height="82" rx="8" />
						<text class="item strong" x={c.x + 12} y={c.y + 24}>{c.title}</text>
						{c.sub.map((s, j) => <text class="sub" x={c.x + 12} y={c.y + 44 + j * 15}>{s}</text>)}
					</g>
				))}
			</g>

			<!-- 03 Report -->
			<g transform={`translate(${report.x} ${TOP})`}>
				<rect class="stage" width={report.w} height={H} rx="10" />
				<text class="num" x="14" y="24">03</text>
				<text class="title" x="14" y="44">Report</text>
				<line class="rule" x1="14" x2={report.w - 14} y1="56" y2="56" />
				<rect class="mini" x="12" y="66" width={report.w - 24} height="90" rx="7" />
				<text class="mono" x="24" y="86">index.html</text>
				<text class="sub" x="24" y="105">React + Cytoscape UI,</text>
				<text class="sub" x="24" y="120">bundled by Vite into</text>
				<text class="sub" x="24" y="135">one file with the report</text>
				{outputs.map((o) => (
					<g>
						<rect class:list={['mini', { planned: o.planned }]} x="12" y={o.y} width={report.w - 24} height="44" rx="7" />
						<text class="mono" x="24" y={o.y + 19}>{o.title}</text>
						<text class="sub" x="24" y={o.y + 35}>{o.sub}</text>
					</g>
				))}
				<text class="sub" x="14" y="290">+ local LLM summary</text>
			</g>

			{[[parse.x + parse.w, analyse.x], [analyse.x + analyse.w, report.x]].map(([a, b]) => (
				<path class="arrow" d={`M${a} 156H${b - 4}m-5-5 5 5-5 5`} />
			))}
			<!-- Input arrows, drawn over the stage edges -->
			<path class="arrow" d={`M126 205H${parse.x + 12 - 4}m-5-5 5 5-5 5`} />
			<path class="arrow" d={`M126 280H${parse.x + 12 - 4}m-5-5 5 5-5 5`} />
			<path class="arrow" d={`M126 392H136V432H${kernelX}V${TOP + 288 + 4}m-5 5 5-5 5 5`} />
		</svg>
	</div>
	<figcaption>Analysis runs on your machine. Only CVE data, scores, link checks and model weights are fetched, then cached.</figcaption>
</figure>

<style>
	.scroll { overflow-x: auto; }
	svg { font-family: var(--sl-font); display: block; width: 100%; min-width: 40rem; height: auto; }
	.band { fill: none; stroke: var(--sl-color-gray-5); stroke-dasharray: 4 4; }
	.host { fill: color-mix(in srgb, var(--sl-color-white) 1.5%, transparent); stroke: var(--sl-color-gray-5); }
	.stage, .input { fill: var(--sl-color-bg); stroke: var(--sl-color-gray-5); }
	.stage.main { stroke: color-mix(in srgb, var(--sl-color-accent) 70%, transparent); fill: color-mix(in srgb, var(--sl-color-accent) 7%, var(--sl-color-bg)); }
	.input.optional { stroke-dasharray: 4 3; }
	.mini { fill: color-mix(in srgb, var(--sl-color-white) 4%, transparent); }
	.mini.planned { fill: none; stroke: var(--sl-color-gray-5); stroke-dasharray: 3 3; }
	.card { fill: var(--sl-color-bg); stroke: color-mix(in srgb, var(--sl-color-accent) 35%, transparent); }
	.enrich { fill: none; stroke: color-mix(in srgb, var(--sl-color-accent) 45%, transparent); stroke-dasharray: 3 3; }
	.enrichtext { font-size: 11.5px; fill: var(--sl-color-gray-2); }
	.feed { fill: color-mix(in srgb, var(--sl-color-accent) 8%, transparent); stroke: color-mix(in srgb, var(--sl-color-accent) 45%, transparent); }
	.feedtext { font-family: var(--sl-font-mono); font-size: 11px; fill: var(--sl-color-accent-high); }
	.kicker, .num, .tag { font-family: var(--sl-font-mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; fill: var(--sl-color-gray-3); }
	.tag { font-size: 9.5px; }
	.num { fill: var(--sl-color-accent-high); }
	.title { font-size: 14px; font-weight: 600; fill: var(--sl-color-white); }
	.title.big { font-size: 16px; }
	.item { font-size: 12.5px; fill: var(--sl-color-gray-1); }
	.item.strong { font-size: 12.5px; font-weight: 600; fill: var(--sl-color-white); }
	.sub { font-size: 11px; fill: var(--sl-color-gray-3); }
	.mono { font-family: var(--sl-font-mono); font-size: 12px; fill: var(--sl-color-white); }
	.rule { stroke: var(--sl-color-gray-6); }
	.arrow, .dash { fill: none; stroke: var(--sl-color-gray-3); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
	.dash { stroke: color-mix(in srgb, var(--sl-color-accent) 55%, transparent); stroke-dasharray: 3 3; }
</style>
