---
// The landing page hero: license label, headline, actions, build targets and the scan video,
// all centred. Replaces Starlight's split hero with its image.
import { Icon } from '@astrojs/starlight/components';
const PAGE_TITLE_ID = '_top'; // Starlight's page title id, which isn't exported

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const targets = [
	{ name: 'Yocto Project', logo: { dark: '/logos/yocto-dark.svg', light: '/logos/yocto-light.svg' }, wordmark: true },
	{ name: 'Buildroot', logo: '/logos/buildroot.png' },
	{ name: 'Android', logo: '/logos/android.svg', soon: true },
	{ name: 'OpenWrt', logo: '/logos/openwrt.svg', soon: true },
];
---

<div class="hero not-content">
	<a class="license" href="https://github.com/corefense-security/trowl/blob/main/LICENSE">
		Open source <span class="dot"></span> Apache 2.0
	</a>
	<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
	{tagline && <p class="tagline" set:html={tagline} />}
	{
		actions.length > 0 && (
			<div class="actions">
				{actions.map(({ icon, link: href, text, variant, attrs = {} }) => (
					<a {href} class:list={['action', variant]} {...attrs}>
						{icon?.type === 'icon' && <Icon name={icon.name} size="1.15rem" />}
						{icon?.type === 'raw' && <Fragment set:html={icon.html} />}
						<span>{text}</span>
					</a>
				))}
			</div>
		)
	}
	<ul class="targets" aria-label="Build systems">
		{
			targets.map((t) => (
				<li class:list={{ soon: t.soon }}>
					{typeof t.logo === 'string' ? (
						<img src={t.logo} alt="" height="22" />
					) : (
						<>
							<img class="theme-dark" src={t.logo.dark} alt={t.name} height="26" />
							<img class="theme-light" src={t.logo.light} alt={t.name} height="26" />
						</>
					)}
					{!t.wordmark && <span>{t.name}</span>}
					{t.soon && <em>Soon</em>}
				</li>
			))
		}
	</ul>
	<video
		class="scan-video"
		src="/videos/trowl-scan.mp4"
		poster="/videos/trowl-scan-poster.jpg"
		autoplay
		loop
		muted
		playsinline
		aria-label="A Trowl scan of a Yocto core-image-minimal image from the terminal to the dashboard"
	></video>
</div>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding-block: clamp(2.5rem, 6vw, 5rem) 1rem;
	}
	.license {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 1.5rem;
		padding: 0.3rem 0.8rem;
		border-radius: 999rem;
		font-size: var(--sl-text-xs);
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		background: color-mix(in srgb, var(--sl-color-white) 5%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sl-color-white) 12%, transparent);
		backdrop-filter: blur(8px);
	}
	.license:hover {
		color: var(--sl-color-white);
	}
	.license .dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.6;
	}
	h1 {
		max-width: 20ch;
		margin: 0;
		font-size: clamp(2.25rem, 1rem + 4.2vw, 3.6rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	h1 :global(em) {
		font-style: normal;
		color: #5fa0ec;
	}
	:global([data-theme='light']) h1 :global(em) {
		color: var(--sl-color-accent);
	}
	.tagline {
		max-width: 42rem;
		margin: 1.1rem 0 0;
		font-size: clamp(var(--sl-text-base), 0.9rem + 0.5vw, var(--sl-text-lg));
		color: var(--sl-color-gray-2);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.action {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.65rem 1.15rem;
		border-radius: 0.65rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		color: var(--sl-color-white);
		background: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sl-color-white) 14%, transparent);
		backdrop-filter: blur(8px);
		transition: background 0.15s;
	}
	.action:hover {
		color: var(--sl-color-white);
		background: color-mix(in srgb, var(--sl-color-white) 12%, transparent);
	}
	.action.primary {
		background: color-mix(in srgb, var(--sl-color-accent) 70%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sl-color-accent-high) 30%, transparent);
		color: #fff;
	}
	.action.primary:hover {
		background: var(--sl-color-accent);
		color: #fff;
	}
	.targets {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 1rem 2.75rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.targets li {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.targets img {
		display: block;
		width: auto;
	}
	.targets li.soon {
		color: var(--sl-color-gray-3);
		font-weight: 500;
	}
	.targets em {
		font-style: normal;
		font-family: var(--sl-font-mono);
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #c9a227;
	}
	:global([data-theme='light']) .targets em {
		color: #9a7a10;
	}
	:global([data-theme='dark']) .theme-light,
	:global([data-theme='light']) .theme-dark {
		display: none;
	}
	.scan-video {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1440 / 900;
		margin-top: 2.75rem;
		border-radius: 0.9rem;
		background: #0d1117;
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--sl-color-white) 10%, transparent),
			0 30px 80px rgb(0 0 0 / 0.35);
	}
</style>
