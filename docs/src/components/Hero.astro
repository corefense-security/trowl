---
// The landing page hero: license label, headline, actions, build targets and the scan video,
// all centred. Replaces Starlight's split hero with its image.
import { Icon } from '@astrojs/starlight/components';
import { REPO, latestTag } from '../lib/release';
const PAGE_TITLE_ID = '_top'; // Starlight's page title id, which isn't exported

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const targets = [
	{ name: 'Yocto Project', logo: { dark: '/logos/yocto-dark.svg', light: '/logos/yocto-light.svg' }, wordmark: true },
	{ name: 'Buildroot', logo: '/logos/buildroot.png' },
	{ name: 'Android', logo: '/logos/android.svg', soon: true },
	{ name: 'OpenWrt', logo: '/logos/openwrt.svg', soon: true },
];

const tag = await latestTag();
---

<div class="hero not-content">
<div class="badges">
	<a class="badge release" href={`https://github.com/${REPO}/releases/tag/${tag}`} data-release={tag}>
		<span class="pulse"></span>
		<span><span class="release-label">Latest</span> <span class="release-tag">{tag}</span></span>
	</a>
	<a class="badge" href={`https://github.com/${REPO}`}>
		Open source
	</a>
	<a class="badge license" href={`https://github.com/${REPO}/blob/main/LICENSE`}>
		Apache 2.0
	</a>
	{/* Official artwork: https://github.com/sigstore/community/tree/main/artwork/cosign */}
	<a class="badge cosign" href="/getting-started/docker/#verify-the-image" aria-label="Signed with Cosign: verify Trowl's container images">
		<img class="theme-light" src="/logos/cosign-color.svg" alt="" width="18" height="18" />
		<img class="theme-dark" src="/logos/cosign-white.svg" alt="" width="18" height="18" />
		Signed with Cosign
	</a>
</div>

<script>
	// Refresh the tag baked in at build time, in case a newer one was pushed since. One request
	// per browser session, and the build-time tag stays if GitHub can't be reached.
	import { REPO, newest } from '../lib/release';
	const badge = document.querySelector<HTMLAnchorElement>('.badge.release');
	const key = 'trowl-latest-tag';
	async function refresh() {
		if (!badge) return;
		let tag: string | null = null;
		try {
			tag = sessionStorage.getItem(key);
		} catch {}
		if (!tag) {
			try {
				const res = await fetch(`https://api.github.com/repos/${REPO}/tags?per_page=100`);
				if (!res.ok) return;
				tag = newest(((await res.json()) as { name: string }[]).map((t) => t.name));
				if (!tag) return;
				try {
					sessionStorage.setItem(key, tag);
				} catch {}
			} catch {
				return;
			}
		}
		if (tag === badge.dataset.release) return;
		badge.dataset.release = tag;
		badge.href = `https://github.com/${REPO}/releases/tag/${tag}`;
		badge.querySelector('.release-tag')!.textContent = tag;
	}
	refresh();
</script>

	<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
	{tagline && <p class="tagline" set:html={tagline} />}
	{
		actions.length > 0 && (
			<div class="actions">
				{actions.map(({ icon, link: href, text, variant, attrs = {} }) => (
					<a {href} class:list={['action', variant]} {...attrs}>
						{icon?.type === 'icon' && <Icon name={icon.name} size="1.15rem" />}
						{icon?.type === 'raw' && <Fragment set:html={icon.html} />}
						<span>{text}</span>
					</a>
				))}
			</div>
		)
	}
	<ul class="targets" aria-label="Build systems">
		{
			targets.map((t) => (
				<li class:list={{ soon: t.soon }}>
					{typeof t.logo === 'string' ? (
						<img src={t.logo} alt="" height="26" />
					) : (
						<>
							<img class="theme-dark" src={t.logo.dark} alt={t.name} height="30" />
							<img class="theme-light" src={t.logo.light} alt={t.name} height="30" />
						</>
					)}
					{!t.wordmark && <span>{t.name}</span>}
					{t.soon && <em>Soon</em>}
				</li>
			))
		}
	</ul>
	<video
		class="scan-video"
		src="/videos/trowl-scan.mp4"
		poster="/videos/trowl-scan-poster.jpg"
		autoplay
		loop
		muted
		playsinline
		aria-label="A Trowl scan of a Yocto core-image-minimal image from the terminal to the dashboard"
	></video>
</div>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding-block: clamp(2.5rem, 6vw, 5rem) 1rem;
	}
	.badges {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-bottom: 1.75rem;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.25rem 0.75rem;
		border-radius: 999rem;
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		line-height: 1.5;
		font-weight: 400;
		letter-spacing: -0.02em;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		background: color-mix(in srgb, var(--sl-color-white) 3%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sl-color-white) 9%, transparent);
		backdrop-filter: blur(8px);
	}
	.badge:hover {
		color: var(--sl-color-white);
	}
	.badge:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 3px;
	}
	.cosign img {
		flex-shrink: 0;
	}
	.release {
		color: #6fdc8c;
		background: color-mix(in srgb, #2ea043 7%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #2ea043 28%, transparent);
	}
	.release-label {
		opacity: 0.7;
	}
	.release:hover {
		color: #9be9a8;
	}
	:global([data-theme='light']) .release {
		color: #1a7f37;
	}
	.pulse {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #3fb950;
		box-shadow: 0 0 0 0 rgb(63 185 80 / 0.6);
		animation: pulse 2.4s ease-out infinite;
	}
	@keyframes pulse {
		70% { box-shadow: 0 0 0 6px rgb(63 185 80 / 0); }
		100% { box-shadow: 0 0 0 0 rgb(63 185 80 / 0); }
	}
	@media (prefers-reduced-motion: reduce) {
		.pulse { animation: none; }
	}
	h1 {
		max-width: 20ch;
		margin: 0;
		font-size: clamp(2.5rem, 1.1rem + 4.6vw, 4rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	h1 :global(em) {
		font-style: normal;
		color: #5fa0ec;
	}
	:global([data-theme='light']) h1 :global(em) {
		color: var(--sl-color-accent);
	}
	.tagline {
		max-width: 42rem;
		margin: 1.1rem 0 0;
		font-size: clamp(var(--sl-text-base), 0.9rem + 0.5vw, var(--sl-text-lg));
		color: var(--sl-color-gray-2);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.action {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.65rem 1.15rem;
		border-radius: 0.65rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		color: var(--sl-color-white);
		background: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sl-color-white) 14%, transparent);
		backdrop-filter: blur(8px);
		transition: background 0.15s;
	}
	.action:hover {
		color: var(--sl-color-white);
		background: color-mix(in srgb, var(--sl-color-white) 12%, transparent);
	}
	/* Docker's brand blue, as other open source projects use for their Docker button. */
	.action.primary {
		color: #fff;
		background: linear-gradient(180deg, #2f8cf0 0%, #1d63ed 100%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.22),
			inset 0 0 0 1px rgb(255 255 255 / 0.08),
			0 6px 20px -6px rgb(29 99 237 / 0.55);
	}
	.action.primary:hover {
		color: #fff;
		background: linear-gradient(180deg, #3b95f2 0%, #2a6ff0 100%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.28),
			inset 0 0 0 1px rgb(255 255 255 / 0.12),
			0 8px 26px -6px rgb(29 99 237 / 0.7);
	}
	.targets {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 1rem 2.75rem;
		margin: 3.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.targets li {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0;
		font-size: 1.1rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
	}
	/* Grayscale and slightly faded at rest so the row reads as one quiet band. Each logo's own
	   colours come back on hover. Only a filter is applied, so the official artwork is unchanged. */
	.targets img {
		display: block;
		width: auto;
		filter: grayscale(1);
		opacity: 0.7;
		transition: filter 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
	}
	.targets li:hover img {
		filter: none;
		opacity: 1;
		transform: translateY(-2px);
	}
	/* Names match the grayscale wordmarks, so no target outweighs the others. */
	.targets li {
		color: var(--sl-color-gray-3);
		font-weight: 500;
		transition: color 0.2s ease;
	}
	:global([data-theme='light']) .targets img {
		opacity: 0.85;
	}
	:global([data-theme='light']) .targets li.soon img {
		opacity: 0.6;
	}
	.targets li:hover {
		color: var(--sl-color-white);
	}
	.targets li.soon {
		color: var(--sl-color-gray-3);
		font-weight: 500;
	}
	.targets li.soon img {
		opacity: 0.45;
	}
	/* Last and theme-qualified, so hover wins over every resting opacity above. */
	.targets li:hover img,
	:global([data-theme]) .targets li:hover img {
		opacity: 1;
	}
	.targets em {
		font-style: normal;
		font-family: var(--sl-font-mono);
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		/* A status pill built like the release badge above, in gold. */
		padding: 0.15rem 0.5rem;
		border-radius: 999rem;
		color: #c9a227;
		background: color-mix(in srgb, #c9a227 8%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #c9a227 30%, transparent);
	}
	:global([data-theme='light']) .targets em {
		color: #9a7a10;
		background: color-mix(in srgb, #9a7a10 8%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #9a7a10 30%, transparent);
	}
	:global([data-theme='dark']) .theme-light,
	:global([data-theme='light']) .theme-dark {
		display: none;
	}
	.scan-video {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1440 / 900;
		margin-top: 4rem;
		border-radius: 0.9rem;
		background: #0d1117;
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--sl-color-white) 10%, transparent),
			0 30px 80px rgb(0 0 0 / 0.35);
	}
</style>
